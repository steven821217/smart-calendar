POSTGRES_PASSWORD=change-me-postgres
DB_NAME=calendar
DB_PASSWORD=change-me-appuser
JWT_SECRET=change-me-32bytes-minimum-secret-value

# --- 內部多智能體委員會（LangGraph）---
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
# 委員會 Coordinator 的 LLM 端點（OpenAI 相容）。三種用法：
#   1) 雲端 OpenAI：留空 LLM_BASE_URL、OPENAI_API_KEY 填真實金鑰。
#   2) 本機 model（ollama/LM Studio，OpenAI 相容）：
#      - 全容器化 docker compose up → LLM_BASE_URL=http://host.docker.internal:11434/v1
#      - host 模式 pnpm dev        → LLM_BASE_URL=http://localhost:11434/v1
#      - OPENAI_API_KEY 需填「非空佔位值」（如 local），否則 fail-closed 不會呼叫；
#        LLM_MODEL 填本機模型名（如 qwen3:14b，需支援 function-calling / JSON structured output）。
#   3) 完全不打 model（只測流程）：設 MCP_STUB_MODEL=1，委員會走 stub 抽取。
LLM_BASE_URL=
# 公務車/需交接資源：前後交接緩衝（分鐘）
RESOURCE_HANDOVER_BUFFER_MINUTES=15
# 視為「需交接」的資源 DB type（逗號分隔；vehicle 為應用層概念，對映 equipment）
RESOURCE_VEHICLE_TYPES=equipment
# 公務車會前提醒提前量（分鐘，功能 A）
VEHICLE_REMINDER_LEAD_MINUTES=30
# 重複事件近期窗口補排天數（7.4）：只排未來 N 天內的 occurrence，靠 maintenance 滾動推進
REMINDER_HORIZON_DAYS=30
# maintenance repeatable job 推進間隔（毫秒，預設 1 天）：以 BullMQ repeatable 驅動、不輪詢 DB
REMINDER_MAINTENANCE_EVERY_MS=86400000

# --- MCP Server（對外傳輸 / 授權）---
# Streamable HTTP 繫結（預設 loopback；正式在前方擺 gateway 處理 TLS/rate-limit）
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=3001
# stdio 本機 dev 授權（擇一：MCP_DEV_TOKEN 或 MCP_DEV_WORKSPACE+MCP_DEV_SUB）
MCP_DEV_WORKSPACE=
MCP_DEV_SUB=
MCP_DEV_SCOPE=availability.read,event.write,resource.book
# 無 OPENAI_API_KEY 時，delegate_complex_scheduling 走 stub 解析（勿用於正式）
MCP_STUB_MODEL=
# OAuth 2.1 consent
OAUTH_CODE_TTL_SEC=300
OAUTH_TOKEN_TTL_SEC=3600
