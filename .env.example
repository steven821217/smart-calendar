POSTGRES_PASSWORD=change-me-postgres
DB_NAME=calendar
DB_PASSWORD=change-me-appuser
JWT_SECRET=change-me-32bytes-minimum-secret-value

# --- 登入（3.1：email + 密碼，scrypt 雜湊）---
# seed 會把示範帳號（a@example.com / b@example.com）的密碼設為此值。
# ⚠️ 僅供本機/CI；正式環境不要執行 seed，也不要沿用此密碼。
SEED_DEMO_PASSWORD=demo-password-1234
# 登入失敗節流（同一 email）：達上限即暫時回 429。設 LOGIN_THROTTLE=0 可關閉（測試用）。
LOGIN_MAX_FAILS=8
LOGIN_FAIL_WINDOW_SEC=900
# 自助註冊（POST /v1/auth/register）：建立新 workspace，註冊者為 admin。
# 封閉部署設 REGISTRATION_ENABLED=0 即關閉；註冊會建 workspace，故有 per-IP 上限。
REGISTRATION_ENABLED=1
REGISTER_MAX_PER_IP=5
REGISTER_WINDOW_SEC=3600

# --- 內部多智能體委員會（LangGraph）---
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
# Query-conditioned ICL（不重新訓練模型，用 embedding 檢索相似示例提升小模型判斷）：
#   INAPP_ICL_K=0 關閉（zero-shot）；預設 4（few-shot 數量非單調，調整前請用基準實測）。
#   INAPP_EMBED_MODEL 需與 LLM_BASE_URL 同一端點可用（本機 ollama 例：embeddinggemma:latest）。
#   embedding 失敗會自動退回 zero-shot，不影響服務可用性。
INAPP_ICL_K=4
INAPP_EMBED_MODEL=embeddinggemma:latest
INAPP_EMBED_TIMEOUT_MS=1500
# 委員會 Coordinator 的 LLM 端點（OpenAI 相容）。三種用法：
#   1) 雲端 OpenAI：留空 LLM_BASE_URL、OPENAI_API_KEY 填真實金鑰。
#   2) 本機 model（ollama/LM Studio，OpenAI 相容）：
#      - 全容器化 docker compose up → LLM_BASE_URL=http://host.docker.internal:11434/v1
#      - host 模式 pnpm dev        → LLM_BASE_URL=http://localhost:11434/v1
#      - OPENAI_API_KEY 需填「非空佔位值」（如 local），否則 fail-closed 不會呼叫；
#        LLM_MODEL 填本機模型名（如 qwen3:14b，需支援 function-calling / JSON structured output）。
#   3) 完全不打 model（只測流程）：設 MCP_STUB_MODEL=1，委員會走 stub 抽取。
LLM_BASE_URL=
# 公務車/需交接資源：前後交接緩衝（分鐘）
RESOURCE_HANDOVER_BUFFER_MINUTES=15
# 視為「需交接」的資源 DB type（逗號分隔；vehicle 為應用層概念，對映 equipment）
RESOURCE_VEHICLE_TYPES=equipment
# 公務車會前提醒提前量（分鐘，功能 A）
VEHICLE_REMINDER_LEAD_MINUTES=30
# 重複事件近期窗口補排天數（7.4）：只排未來 N 天內的 occurrence，靠 maintenance 滾動推進
REMINDER_HORIZON_DAYS=30
# maintenance repeatable job 推進間隔（毫秒，預設 1 天）：以 BullMQ repeatable 驅動、不輪詢 DB
REMINDER_MAINTENANCE_EVERY_MS=86400000

# --- MCP Server（對外傳輸 / 授權）---
# Streamable HTTP 繫結（預設 loopback；正式在前方擺 gateway 處理 TLS/rate-limit）
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=3001
# stdio 本機 dev 授權（擇一：MCP_DEV_TOKEN 或 MCP_DEV_WORKSPACE+MCP_DEV_SUB）
MCP_DEV_WORKSPACE=
MCP_DEV_SUB=
MCP_DEV_SCOPE=availability.read,event.write,resource.book
# 無 OPENAI_API_KEY 時，delegate_complex_scheduling 走 stub 解析（勿用於正式）
MCP_STUB_MODEL=
# OAuth 2.1 consent
OAUTH_CODE_TTL_SEC=300
# access token 壽命（秒）。PoC 刻意設長（30 天 = 2592000）以免每小時重新授權；
# 安全靠「即時撤銷」兜底（每次 MCP tool 呼叫都查 Redis 黑名單）。
# 正式環境應改短效 token + refresh token 輪替。
OAUTH_TOKEN_TTL_SEC=2592000
# --- OAuth 自動發現（讓支援 OAuth 的 MCP client 一鍵連線）---
# 對外基底 URL：寫進 discovery metadata 與 WWW-Authenticate。留空則由反代標頭推導。
PUBLIC_BASE_URL=
# redirect_uri 白名單（逗號分隔的 https 前綴）。loopback（http://127.0.0.1:<port>/…）
# 一律允許，供桌面/CLI client 使用；其餘 https 位址必須列在此處才會被接受。
# ⚠️ 切勿放寬成任意網址——那等於把授權碼送給攻擊者（open redirect → 帳號接管）。
# 例：OAUTH_REDIRECT_ALLOWLIST=https://claude.ai/api/mcp/auth_callback
OAUTH_REDIRECT_ALLOWLIST=
# 推測式 cascade（ICLR 2025）：與第一層並行預跑第二層，命中就省一次呼叫。設 0 可關閉。
INAPP_SPECULATE=1

# --- 內網開放（同一 Wi-Fi 的其他機器要連線時設定）---
# GATEWAY_BIND：gateway 對外繫結的位址。預設 127.0.0.1（只有本機連得到，安全預設）。
#   設 0.0.0.0 開放給所有網卡；或填某張網卡的 IP 縮小範圍。
# GATEWAY_HOST / GATEWAY_SAN_IPS / GATEWAY_SAN_DNS：
#   自簽憑證的 SAN 必須包含「對方實際輸入的位址」，否則憑證驗證失敗。
#   SAN 清單有變時 gateway 會自動重簽（見 gateway/entrypoint.sh）。
# MCP_ALLOWED_ORIGINS：瀏覽器帶 Origin 時的允許清單（DNS rebinding 防護）。
#   非瀏覽器的 MCP client 不帶 Origin，不受影響。
#
# 要拿「對方什麼都不用裝」的真憑證：用 DNS-01 challenge 簽一張（不需開對外連接埠，
# A 記錄可指向內網 IP），再把 gateway.crt/gateway.key 掛進 /etc/nginx/certs。
# 只要憑證檔已存在且非本腳本自簽，entrypoint 就不會覆蓋它。
GATEWAY_BIND=127.0.0.1
GATEWAY_HOST=localhost
GATEWAY_SAN_IPS=
GATEWAY_SAN_DNS=
MCP_ALLOWED_ORIGINS=
